.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.item { padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.item:last-child { border-bottom: none; }
.unlock { padding: 20rpx; border-radius: 12rpx; margin-bottom: 20rpx; color: #fff; font-size: 28rpx; text-align: center; }
.unlock-green { background: #22a06b; }
.unlock-yellow { background: #faad14; }
.unlock-red { background: #ff4d4f; }

/* 取物码弹层 */
.qrmask { position: fixed; left: 0; top: 0; width: 100%; height: 100vh;
          background: rgba(0,0,0,.75); z-index: 999;
          display: flex; align-items: center; justify-content: center; }
.qrbox { background: #fff; border-radius: 24rpx; padding: 48rpx; width: 640rpx;
         display: flex; flex-direction: column; align-items: center; }
.qrtitle { font-size: 40rpx; font-weight: 600; margin-bottom: 32rpx; }
.qrimg { width: 520rpx; height: 520rpx; background: #fff; }
.qrhint { font-size: 30rpx; color: #1677ff; margin: 24rpx 0 8rpx; text-align: center; }
