<view class="wrap">
  <view class="hd">
    <view>
      <view class="title">我的冰箱</view>
      <view class="role">{{user.name || '同学'}} · {{user.room || '未填房间'}} · 学生</view>
    </view>
    <view class="btn btn-ghost btn-sm" bindtap="logout">退出</view>
  </view>

  <view wx:if="{{unlockTip}}" class="unlock unlock-{{unlockColor}}">{{unlockTip}}</view>

  <view class="card">
    <view class="hd">
      <view class="card-title" style="margin:0">我的宿舍</view>
      <view class="btn btn-ghost btn-sm" bindtap="editProfile">改姓名/寝室</view>
    </view>
    <view class="muted">楼宇：{{user.building || '未分配（请尽快联系超管补选）'}}</view>
    <view class="muted">寝室：{{user.room || '-'}} · 姓名：{{user.name || '-'}}</view>
    <view class="muted" style="margin-top:8rpx">
      楼选错了？
      <text wx:if="{{adminContact}}" class="link" bindtap="copyContact">联系超管：{{adminContact}}（点击复制）</text>
      <text wx:else>只有超管能改，请找宿管帮你联系超管</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">冰箱触控屏</view>
    <view class="muted">存入在冰箱触控屏完成：屏幕选「存入物品」会出现登录码 → 点下面按钮扫码 → 在屏幕拍照登记，标签自动打印、箱门自动开锁。</view>
    <button class="btn btn-primary" style="margin-top:16rpx" bindtap="scanLogin">扫屏幕登录码</button>
    <button class="btn btn-green" style="margin-top:12rpx" bindtap="scanClaim">扫标签二维码认领物品</button>
    <button class="btn btn-ghost" style="margin-top:12rpx" bindtap="subscribeRemind">开启到期提醒</button>
    <view class="muted" style="margin-top:8rpx">弹窗请勾选"总是保持以上选择"，之后每次取出/扫码会自动续提醒额度，不再弹窗</view>
  </view>

  <view class="card">
    <view class="card-title">我存放的物品（按紧急度排序）</view>
    <view wx:if="{{items.length === 0}}" class="empty">暂无存放物品</view>
    <view wx:for="{{items}}" wx:key="id" class="item list-item">
      <view class="li-main">
        <view class="li-name">{{item.name}} <text class="badge badge-{{item.color}}">{{item.color_label}}</text></view>
        <view class="muted">{{item.category}} · 数量{{item.quantity}} · 约{{item.vol_l}}L · 到期 {{item.expire_at}} · 编码 {{item.code}}</view>
      </view>
      <view class="col">
        <view class="btn btn-ghost btn-sm act" data-id="{{item.id}}" bindtap="showQr">取物码</view>
        <view class="btn btn-ghost btn-sm act" data-code="{{item.code}}" data-id="{{item.id}}" bindtap="unlockItem">取出开锁</view>
        <view class="btn btn-ghost btn-sm act" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="renameItem">改名</view>
        <view class="btn btn-ghost btn-sm act" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="markTaken">已取出</view>
      </view>
    </view>
  </view>

  <view wx:if="{{qrShow}}" class="qrmask" bindtap="hideQr">
    <view class="qrbox" catchtap="noop">
      <view class="qrtitle">{{qr.name}} · 取物码</view>
      <image src="{{qr.img}}" class="qrimg"></image>
      <view class="qrhint">把手机屏幕上的二维码对准冰箱的摄像头</view>
      <view class="muted">编码 {{qr.code}} · 点击空白处关闭</view>
    </view>
  </view>
</view>
