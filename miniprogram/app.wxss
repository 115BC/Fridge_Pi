page { background: #f4f6f8; font-size: 28rpx; color: #222; }
.wrap { padding: 24rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx;
        box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05); }
.hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.hd .title { font-size: 34rpx; font-weight: 600; }
.hd .role { font-size: 24rpx; color: #888; }
.btn { border-radius: 12rpx; font-size: 30rpx; padding: 18rpx 0; text-align: center; }
.btn-primary { background: #1677ff; color: #fff; }
.btn-green { background: #22a06b; color: #fff; }
.btn-ghost { background: #eef1f5; color: #333; }
.btn-sm { font-size: 24rpx; padding: 10rpx 20rpx; border-radius: 10rpx; }
.row { display: flex; align-items: center; }
.muted { color: #999; font-size: 24rpx; }
.badge { display: inline-block; padding: 4rpx 16rpx; border-radius: 20rpx;
         font-size: 22rpx; color: #fff; }
.badge-red { background: #ff4d4f; }
.badge-yellow { background: #faad14; }
.badge-green { background: #52c41a; }
.field { margin-bottom: 20rpx; }
.field label { display: block; font-size: 26rpx; color: #555; margin-bottom: 8rpx; }
.field input, .field picker { background: #f4f6f8; border-radius: 10rpx; padding: 16rpx; font-size: 28rpx; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.tab { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 10rpx; background: #eef1f5; font-size: 26rpx; }
.tab.on { background: #1677ff; color: #fff; }
.empty { text-align: center; color: #aaa; padding: 60rpx 0; }
.list-item { display: flex; justify-content: space-between; align-items: center; }
.li-main { flex: 1; }
.li-name { font-size: 30rpx; font-weight: 600; }
