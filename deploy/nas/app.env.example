JWT_SECRET=replace-with-production-jwt-secret
PI_SECRET=replace-with-matching-pi-secret
BUILD_TAG=2026-11-24-nas

# 二维码直达链接使用的网站入口；留空则使用请求域名
PUBLIC_SITE_URL=https://game.95270507.xyz:16666

SMTP_HOST=smtp.126.com
SMTP_PORT=465
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=寝室冰箱管理 <replace-with-sender@126.com>

# 网站部署不接小程序登录；如需保留后端微信能力，再按需填写。
WX_APPID=
WX_SECRET=
WX_TEMPLATE_ID=

# 空库首次启动时创建超管；首次登录会强制改密，创建后建议删除这两项。
WEB_BOOTSTRAP_USERNAME=
WEB_BOOTSTRAP_PASSWORD=

# MYSQL_ADDRESS 必须留空：NAS 使用 SQLite。
MYSQL_ADDRESS=
ALLOW_DB_TRANSFER=
